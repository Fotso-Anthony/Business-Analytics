    {
      "parameters": {
        "jsCode": "function generer_id(date, mail, nom) {\n  const chaine = `${date}${mail}${nom}`;\n  let hash = 0;\n  for (let i = 0; i < chaine.length; i++) {\n    const char = chaine.charCodeAt(i);\n    hash = ((hash << 5) - hash) + char;\n    hash = hash & hash; \n  }\n return \"REC-\" + Math.abs(hash).toString(16).toUpperCase();\n}\nconst id_reclam = generer_id($('Recuperation reclamations').first().json.body.date_soumission, $('Recuperation reclamations').first().json.body.mail_client, $('Recuperation reclamations').first().json.body.nom_client)\nconst items = $input.all();\nconst texte = items[0].json.output[0].content[0].text;\nconst propre = texte.replace(/```json|```/g, \"\").trim();\nconst resultat = JSON.parse(propre);\n\n\nreturn {\n  json: {\n    Id : id_reclam,\n    priorite         : resultat.priorite,\n    bu_assignee      : resultat.bu_assignee,\n    resume           : resultat.resume,\n    reponse_client   : resultat.reponse,\n    corpus : resultat.Corpus,    \n    DG : \"mbargadepaule65@gmail.com\", \n    \n    DGA : \"tchummotchapong@gmail.com\"\n  }\n};"
      },
