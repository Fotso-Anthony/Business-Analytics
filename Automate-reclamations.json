      "parameters": {
        "jsCode": "function get_responsable_bu(bu_name) {\n  const Resp_BU = [\n    { \"row_number\": 2, \"Nom_BU\": \"Technique\",   \"Responsable\": \"Franck TOHAM\", \"Mail Reponsable\": \"roimanitou73@gmail.com\" },\n    { \"row_number\": 3, \"Nom_BU\": \"Commercial\",  \"Responsable\": \"Suzy MASSU\",     \"Mail Reponsable\": \"massusuzy@gmail.com\" },\n    { \"row_number\": 4, \"Nom_BU\": \"Facturation\", \"Responsable\": \"Yvan WAFO\",      \"Mail Reponsable\": \"wafoyvan16@gmail.com\" },\n    { \"row_number\": 5, \"Nom_BU\": \"Juridique\",   \"Responsable\": \"Georges TIAM\",   \"Mail Reponsable\": \"georges.tiam@gmail.com\" }\n  ];\n\n  const bu = Resp_BU.find(item => item.Nom_BU === $input.first().json.bu_assignee);\n\n  if (!bu) {\n    throw new Error(`BU \"${bu_name}\" introuvable`);\n  }\n\n  return {\n    nom_bu       : bu.Nom_BU,\n    responsable  : bu.Responsable,\n    mail         : bu[\"Mail Reponsable\"]\n  };\n}\n\n// ── Utilisation ──\nconst bu_assignee = $json.bu_assignee; // vient du nœud précédent\n\nconst responsable = get_responsable_bu(bu_assignee);\n\nreturn {\n  json: {\n    ...($json),                          // conserve toutes les données existantes\n    nom_responsable  : responsable.responsable,\n    mail_responsable : responsable.mail\n  }\n};"
      },
